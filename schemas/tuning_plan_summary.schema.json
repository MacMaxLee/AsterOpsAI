{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TuningPlanSummary",
  "type": "object",
  "required": [
    "candidates_json",
    "created_at",
    "id",
    "mode",
    "profile",
    "status",
    "target_identity_json"
  ],
  "properties": {
    "candidates_json": {
      "description": "Raw JSON array of each candidate action's final outcome — see this module's own doc comment.",
      "type": "string"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "mode": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "target_identity_json": {
      "description": "Raw `TargetIdentity` JSON — see this module's own doc comment.",
      "type": "string"
    }
  }
}
