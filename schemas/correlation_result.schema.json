{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CorrelationResult",
  "type": "object",
  "required": [
    "ranked",
    "ruled_out",
    "window_end",
    "window_start"
  ],
  "properties": {
    "ranked": {
      "description": "Sorted descending by `confidence`.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Hypothesis"
      }
    },
    "ruled_out": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RuledOut"
      }
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "Evidence": {
      "type": "object",
      "required": [
        "metric",
        "observed",
        "threshold",
        "window_end",
        "window_start"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "observed": {
          "type": "number",
          "format": "double"
        },
        "threshold": {
          "type": "number",
          "format": "double"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "window_end": {
          "type": "string",
          "format": "date-time"
        },
        "window_start": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Hypothesis": {
      "type": "object",
      "required": [
        "cause",
        "confidence",
        "evidence"
      ],
      "properties": {
        "cause": {
          "$ref": "#/definitions/RootCause"
        },
        "confidence": {
          "type": "number",
          "format": "double"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Evidence"
          }
        }
      }
    },
    "RootCause": {
      "description": "SRS FR-CORR-002's exact nine-value list.",
      "type": "string",
      "enum": [
        "DB_LOCKS",
        "DB_CONFIGURATION",
        "CONNECTION_EXHAUSTION",
        "SLOW_SQL",
        "HOST_CPU",
        "HOST_MEMORY",
        "STORAGE_LATENCY",
        "NETWORK",
        "CLIENT_SIDE_APPLICATION"
      ]
    },
    "RuledOut": {
      "type": "object",
      "required": [
        "cause",
        "reason"
      ],
      "properties": {
        "cause": {
          "$ref": "#/definitions/RootCause"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
