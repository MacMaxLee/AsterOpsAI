{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Envelope_for_TuningPlanOutcome",
  "description": "Every API response is wrapped in this envelope: `{success, timestamp, request_id, data, error}`. Exactly one of `data`/`error` is populated, matching `success`.",
  "type": "object",
  "required": [
    "request_id",
    "success",
    "timestamp"
  ],
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/definitions/TuningPlanOutcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/ApiError"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "ApiError": {
      "description": "Closed, wire-facing error type. Every API error response carries exactly one of these variants — never a bare string — so clients can branch on `code` exhaustively instead of pattern-matching on message text.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "BAD_REQUEST"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "NOT_FOUND"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNSUPPORTED"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "PERMISSION_REQUIRED"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNAVAILABLE"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INTERNAL"
              ]
            }
          }
        }
      ]
    },
    "TuningCandidateOutcome": {
      "type": "object",
      "required": [
        "action_type",
        "outcome"
      ],
      "properties": {
        "action_type": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "type": "string"
        },
        "row_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      }
    },
    "TuningPlanOutcome": {
      "description": "Unit U23: the real, immediate result of starting a tuning plan — unlike `TuningPlanSummary` (a later, read-only listing), this is the *only* place a `RECOMMEND_ONLY` plan's candidates are ever visible at all (nothing else persists them anywhere a human could see later), so it mirrors `core::tuning::{TuningOutcome, CandidateOutcome}` field-for-field rather than passing anything through raw.",
      "type": "object",
      "required": [
        "candidates",
        "plan_id",
        "status"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TuningCandidateOutcome"
          }
        },
        "plan_id": {
          "type": "integer",
          "format": "int64"
        },
        "status": {
          "type": "string"
        }
      }
    }
  }
}
