{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Envelope_for_CorrelationResult",
  "description": "Every API response is wrapped in this envelope: `{success, timestamp, request_id, data, error}`. Exactly one of `data`/`error` is populated, matching `success`.",
  "type": "object",
  "required": [
    "request_id",
    "success",
    "timestamp"
  ],
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/definitions/CorrelationResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/ApiError"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "ApiError": {
      "description": "Closed, wire-facing error type. Every API error response carries exactly one of these variants — never a bare string — so clients can branch on `code` exhaustively instead of pattern-matching on message text.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "BAD_REQUEST"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "NOT_FOUND"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNSUPPORTED"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "PERMISSION_REQUIRED"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNAVAILABLE"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INTERNAL"
              ]
            }
          }
        }
      ]
    },
    "CorrelationResult": {
      "type": "object",
      "required": [
        "ranked",
        "ruled_out",
        "window_end",
        "window_start"
      ],
      "properties": {
        "ranked": {
          "description": "Sorted descending by `confidence`.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Hypothesis"
          }
        },
        "ruled_out": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RuledOut"
          }
        },
        "window_end": {
          "type": "string",
          "format": "date-time"
        },
        "window_start": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Evidence": {
      "type": "object",
      "required": [
        "metric",
        "observed",
        "threshold",
        "window_end",
        "window_start"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "observed": {
          "type": "number",
          "format": "double"
        },
        "threshold": {
          "type": "number",
          "format": "double"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "window_end": {
          "type": "string",
          "format": "date-time"
        },
        "window_start": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Hypothesis": {
      "type": "object",
      "required": [
        "cause",
        "confidence",
        "evidence"
      ],
      "properties": {
        "cause": {
          "$ref": "#/definitions/RootCause"
        },
        "confidence": {
          "type": "number",
          "format": "double"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Evidence"
          }
        }
      }
    },
    "RootCause": {
      "description": "SRS FR-CORR-002's exact nine-value list.",
      "type": "string",
      "enum": [
        "DB_LOCKS",
        "DB_CONFIGURATION",
        "CONNECTION_EXHAUSTION",
        "SLOW_SQL",
        "HOST_CPU",
        "HOST_MEMORY",
        "STORAGE_LATENCY",
        "NETWORK",
        "CLIENT_SIDE_APPLICATION"
      ]
    },
    "RuledOut": {
      "type": "object",
      "required": [
        "cause",
        "reason"
      ],
      "properties": {
        "cause": {
          "$ref": "#/definitions/RootCause"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
