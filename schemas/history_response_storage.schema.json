{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HistoryResponse_for_StorageHistoryPoint",
  "type": "object",
  "required": [
    "points",
    "requested_from",
    "requested_to",
    "resolved_tier"
  ],
  "properties": {
    "points": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/StorageHistoryPoint"
      }
    },
    "requested_from": {
      "type": "string",
      "format": "date-time"
    },
    "requested_to": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_tier": {
      "$ref": "#/definitions/HistoryTier"
    },
    "truncated_from": {
      "description": "Set when the requested range was clamped (e.g. `from` older than the 2-year daily-rollup retention horizon).",
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "definitions": {
    "HistoryStat": {
      "description": "One metric's statistics over a bucket. Raw-tier points reuse this same shape (`avg == min == max ==` the single value, `supported_sample_count ∈ {0, 1}`) so the console never has to branch on tier shape (FR-CONSOLE-001). `avg`/`min`/`max` are `None` when `supported_sample_count == 0` — never a fabricated number for an all-gap/all-unavailable bucket.",
      "type": "object",
      "required": [
        "supported_sample_count",
        "total_sample_count"
      ],
      "properties": {
        "avg": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "supported_sample_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "total_sample_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "HistoryTier": {
      "description": "Which persisted rollup tier a history query actually resolved to.",
      "type": "string",
      "enum": [
        "RAW",
        "HOURLY",
        "DAILY"
      ]
    },
    "StorageHistoryPoint": {
      "type": "object",
      "required": [
        "bucket_end",
        "bucket_start",
        "read_bytes_per_sec",
        "write_bytes_per_sec"
      ],
      "properties": {
        "bucket_end": {
          "type": "string",
          "format": "date-time"
        },
        "bucket_start": {
          "type": "string",
          "format": "date-time"
        },
        "read_bytes_per_sec": {
          "$ref": "#/definitions/HistoryStat"
        },
        "write_bytes_per_sec": {
          "$ref": "#/definitions/HistoryStat"
        }
      }
    }
  }
}
