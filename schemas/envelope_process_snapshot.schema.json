{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Envelope_for_ProcessSnapshot",
  "description": "Every API response is wrapped in this envelope: `{success, timestamp, request_id, data, error}`. Exactly one of `data`/`error` is populated, matching `success`.",
  "type": "object",
  "required": [
    "request_id",
    "success",
    "timestamp"
  ],
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/definitions/ProcessSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/ApiError"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "ApiError": {
      "description": "Closed, wire-facing error type. Every API error response carries exactly one of these variants — never a bare string — so clients can branch on `code` exhaustively instead of pattern-matching on message text.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "BAD_REQUEST"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "NOT_FOUND"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNSUPPORTED"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "PERMISSION_REQUIRED"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNAVAILABLE"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INTERNAL"
              ]
            }
          }
        }
      ]
    },
    "Capability": {
      "description": "A metric family's ability level. Every non-`Supported` variant carries a human-readable reason — the server never reports a fabricated zero in place of data it genuinely doesn't have (SRS FR-CAP-001).",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "SUPPORTED"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "LIMITED"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "UNAVAILABLE"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "PERMISSION_REQUIRED"
              ]
            }
          }
        }
      ]
    },
    "MetricValue_for_String": {
      "description": "A single telemetry number, tagged with why it might not be a plain value. Used for both genuine rates (CPU%, network throughput) and point-in-time gauges (memory used, disk free) — gauges simply never produce the `SampleGap`/`CounterReset` variants. Deliberately separate from `SelfMetricValue<T>` (U0's service self-monitoring type); unifying the two is a candidate for a later cleanup unit, not this one.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "SUPPORTED"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "description": "Elapsed time between samples exceeded 2x the configured sample interval — a rate computed across that gap would be misleading.",
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "SAMPLE_GAP"
              ]
            }
          }
        },
        {
          "description": "The underlying counter decreased between samples (NIC reinit, process restart, etc.) — never reported as a negative rate.",
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "COUNTER_RESET"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "UNAVAILABLE"
              ]
            }
          }
        }
      ]
    },
    "MetricValue_for_double": {
      "description": "A single telemetry number, tagged with why it might not be a plain value. Used for both genuine rates (CPU%, network throughput) and point-in-time gauges (memory used, disk free) — gauges simply never produce the `SampleGap`/`CounterReset` variants. Deliberately separate from `SelfMetricValue<T>` (U0's service self-monitoring type); unifying the two is a candidate for a later cleanup unit, not this one.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "SUPPORTED"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Elapsed time between samples exceeded 2x the configured sample interval — a rate computed across that gap would be misleading.",
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "SAMPLE_GAP"
              ]
            }
          }
        },
        {
          "description": "The underlying counter decreased between samples (NIC reinit, process restart, etc.) — never reported as a negative rate.",
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "COUNTER_RESET"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "UNAVAILABLE"
              ]
            }
          }
        }
      ]
    },
    "MetricValue_for_uint64": {
      "description": "A single telemetry number, tagged with why it might not be a plain value. Used for both genuine rates (CPU%, network throughput) and point-in-time gauges (memory used, disk free) — gauges simply never produce the `SampleGap`/`CounterReset` variants. Deliberately separate from `SelfMetricValue<T>` (U0's service self-monitoring type); unifying the two is a candidate for a later cleanup unit, not this one.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "SUPPORTED"
              ]
            },
            "value": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          }
        },
        {
          "description": "Elapsed time between samples exceeded 2x the configured sample interval — a rate computed across that gap would be misleading.",
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "SAMPLE_GAP"
              ]
            }
          }
        },
        {
          "description": "The underlying counter decreased between samples (NIC reinit, process restart, etc.) — never reported as a negative rate.",
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "COUNTER_RESET"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "UNAVAILABLE"
              ]
            }
          }
        }
      ]
    },
    "ProcessCategory": {
      "description": "SRS FR-PRO-003: deterministic process classification.",
      "type": "string",
      "enum": [
        "SYSTEM",
        "USER_APPLICATION",
        "BACKGROUND_SERVICE",
        "DBMS_ENGINE",
        "UNKNOWN"
      ]
    },
    "ProcessInfo": {
      "type": "object",
      "required": [
        "category",
        "cmdline",
        "comm",
        "cpu_percent",
        "disk_io_capability",
        "disk_read_bytes_per_sec",
        "disk_write_bytes_per_sec",
        "network_io_capability",
        "network_rx_bytes_per_sec",
        "network_tx_bytes_per_sec",
        "owner_uid",
        "pid",
        "rss_bytes",
        "start_time_ticks"
      ],
      "properties": {
        "category": {
          "$ref": "#/definitions/ProcessCategory"
        },
        "cmdline": {
          "$ref": "#/definitions/MetricValue_for_String"
        },
        "comm": {
          "type": "string"
        },
        "cpu_percent": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "disk_io_capability": {
          "$ref": "#/definitions/Capability"
        },
        "disk_read_bytes_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "disk_write_bytes_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "network_io_capability": {
          "$ref": "#/definitions/Capability"
        },
        "network_rx_bytes_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "network_tx_bytes_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "owner_uid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "rss_bytes": {
          "$ref": "#/definitions/MetricValue_for_uint64"
        },
        "start_time_ticks": {
          "description": "`/proc/[pid]/stat` field 22 — reserved for the target-identity re-verification scheme actions will need starting in unit U8; unused this unit.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "ProcessSnapshot": {
      "type": "object",
      "required": [
        "processes",
        "timestamp",
        "total_count"
      ],
      "properties": {
        "processes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProcessInfo"
          }
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "total_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    }
  }
}
