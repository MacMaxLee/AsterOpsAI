{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Envelope_for_Array_of_GucValue",
  "description": "Every API response is wrapped in this envelope: `{success, timestamp, request_id, data, error}`. Exactly one of `data`/`error` is populated, matching `success`.",
  "type": "object",
  "required": [
    "request_id",
    "success",
    "timestamp"
  ],
  "properties": {
    "data": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/GucValue"
      }
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/ApiError"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "ApiError": {
      "description": "Closed, wire-facing error type. Every API error response carries exactly one of these variants — never a bare string — so clients can branch on `code` exhaustively instead of pattern-matching on message text.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "BAD_REQUEST"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "NOT_FOUND"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNSUPPORTED"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "PERMISSION_REQUIRED"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNAVAILABLE"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INTERNAL"
              ]
            }
          }
        }
      ]
    },
    "GucValue": {
      "description": "Unit U37: mirrors `core::dbms::GucValue` field-for-field.",
      "type": "object",
      "required": [
        "name",
        "setting",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "setting": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
