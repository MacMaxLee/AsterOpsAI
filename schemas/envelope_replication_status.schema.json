{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Envelope_for_ReplicationStatus",
  "description": "Every API response is wrapped in this envelope: `{success, timestamp, request_id, data, error}`. Exactly one of `data`/`error` is populated, matching `success`.",
  "type": "object",
  "required": [
    "request_id",
    "success",
    "timestamp"
  ],
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/definitions/ReplicationStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/ApiError"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "ApiError": {
      "description": "Closed, wire-facing error type. Every API error response carries exactly one of these variants — never a bare string — so clients can branch on `code` exhaustively instead of pattern-matching on message text.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "BAD_REQUEST"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "NOT_FOUND"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNSUPPORTED"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "PERMISSION_REQUIRED"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNAVAILABLE"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INTERNAL"
              ]
            }
          }
        }
      ]
    },
    "ReplicationStatus": {
      "description": "Unit U37: mirrors `core::dbms::ReplicationStatus` field-for-field. The first `/dbms/*` endpoint whose success payload is a single object, not a `Vec<T>`.",
      "type": "object",
      "required": [
        "in_recovery",
        "is_primary",
        "standbys"
      ],
      "properties": {
        "in_recovery": {
          "type": "boolean"
        },
        "is_primary": {
          "type": "boolean"
        },
        "standbys": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StandbyInfo"
          }
        }
      }
    },
    "StandbyInfo": {
      "description": "Unit U37: mirrors `core::dbms::StandbyInfo` field-for-field.",
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "client_addr": {
          "type": [
            "string",
            "null"
          ]
        },
        "flush_lsn": {
          "type": [
            "string",
            "null"
          ]
        },
        "replay_lag_seconds": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "replay_lsn": {
          "type": [
            "string",
            "null"
          ]
        },
        "sent_lsn": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": "string"
        },
        "write_lsn": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
