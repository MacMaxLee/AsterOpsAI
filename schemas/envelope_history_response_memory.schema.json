{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Envelope_for_HistoryResponse_for_MemoryHistoryPoint",
  "description": "Every API response is wrapped in this envelope: `{success, timestamp, request_id, data, error}`. Exactly one of `data`/`error` is populated, matching `success`.",
  "type": "object",
  "required": [
    "request_id",
    "success",
    "timestamp"
  ],
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/definitions/HistoryResponse_for_MemoryHistoryPoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/ApiError"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "ApiError": {
      "description": "Closed, wire-facing error type. Every API error response carries exactly one of these variants — never a bare string — so clients can branch on `code` exhaustively instead of pattern-matching on message text.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "BAD_REQUEST"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "NOT_FOUND"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNSUPPORTED"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "PERMISSION_REQUIRED"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNAVAILABLE"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INTERNAL"
              ]
            }
          }
        }
      ]
    },
    "HistoryResponse_for_MemoryHistoryPoint": {
      "type": "object",
      "required": [
        "points",
        "requested_from",
        "requested_to",
        "resolved_tier"
      ],
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MemoryHistoryPoint"
          }
        },
        "requested_from": {
          "type": "string",
          "format": "date-time"
        },
        "requested_to": {
          "type": "string",
          "format": "date-time"
        },
        "resolved_tier": {
          "$ref": "#/definitions/HistoryTier"
        },
        "truncated_from": {
          "description": "Set when the requested range was clamped (e.g. `from` older than the 2-year daily-rollup retention horizon).",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "HistoryStat": {
      "description": "One metric's statistics over a bucket. Raw-tier points reuse this same shape (`avg == min == max ==` the single value, `supported_sample_count ∈ {0, 1}`) so the console never has to branch on tier shape (FR-CONSOLE-001). `avg`/`min`/`max` are `None` when `supported_sample_count == 0` — never a fabricated number for an all-gap/all-unavailable bucket.",
      "type": "object",
      "required": [
        "supported_sample_count",
        "total_sample_count"
      ],
      "properties": {
        "avg": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "supported_sample_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "total_sample_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "HistoryTier": {
      "description": "Which persisted rollup tier a history query actually resolved to.",
      "type": "string",
      "enum": [
        "RAW",
        "HOURLY",
        "DAILY"
      ]
    },
    "MemoryHistoryPoint": {
      "type": "object",
      "required": [
        "bucket_end",
        "bucket_start",
        "used_bytes"
      ],
      "properties": {
        "bucket_end": {
          "type": "string",
          "format": "date-time"
        },
        "bucket_start": {
          "type": "string",
          "format": "date-time"
        },
        "used_bytes": {
          "$ref": "#/definitions/HistoryStat"
        }
      }
    }
  }
}
