{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NetworkSnapshot",
  "type": "object",
  "required": [
    "interfaces",
    "timestamp"
  ],
  "properties": {
    "interfaces": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/NetworkInterfaceInfo"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "MetricValue_for_double": {
      "description": "A single telemetry number, tagged with why it might not be a plain value. Used for both genuine rates (CPU%, network throughput) and point-in-time gauges (memory used, disk free) — gauges simply never produce the `SampleGap`/`CounterReset` variants. Deliberately separate from `SelfMetricValue<T>` (U0's service self-monitoring type); unifying the two is a candidate for a later cleanup unit, not this one.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "SUPPORTED"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Elapsed time between samples exceeded 2x the configured sample interval — a rate computed across that gap would be misleading.",
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "SAMPLE_GAP"
              ]
            }
          }
        },
        {
          "description": "The underlying counter decreased between samples (NIC reinit, process restart, etc.) — never reported as a negative rate.",
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "COUNTER_RESET"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "UNAVAILABLE"
              ]
            }
          }
        }
      ]
    },
    "NetworkInterfaceInfo": {
      "type": "object",
      "required": [
        "name",
        "rx_bytes_per_sec",
        "rx_drops_per_sec",
        "rx_errors_per_sec",
        "rx_packets_per_sec",
        "tx_bytes_per_sec",
        "tx_drops_per_sec",
        "tx_errors_per_sec",
        "tx_packets_per_sec"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "rx_bytes_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "rx_drops_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "rx_errors_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "rx_packets_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "tx_bytes_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "tx_drops_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "tx_errors_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "tx_packets_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        }
      }
    }
  }
}
