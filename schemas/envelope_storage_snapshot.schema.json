{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Envelope_for_StorageSnapshot",
  "description": "Every API response is wrapped in this envelope: `{success, timestamp, request_id, data, error}`. Exactly one of `data`/`error` is populated, matching `success`.",
  "type": "object",
  "required": [
    "request_id",
    "success",
    "timestamp"
  ],
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/definitions/StorageSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/ApiError"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "ApiError": {
      "description": "Closed, wire-facing error type. Every API error response carries exactly one of these variants — never a bare string — so clients can branch on `code` exhaustively instead of pattern-matching on message text.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "BAD_REQUEST"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "NOT_FOUND"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNSUPPORTED"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "PERMISSION_REQUIRED"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNAVAILABLE"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INTERNAL"
              ]
            }
          }
        }
      ]
    },
    "MetricValue_for_double": {
      "description": "A single telemetry number, tagged with why it might not be a plain value. Used for both genuine rates (CPU%, network throughput) and point-in-time gauges (memory used, disk free) — gauges simply never produce the `SampleGap`/`CounterReset` variants. Deliberately separate from `SelfMetricValue<T>` (U0's service self-monitoring type); unifying the two is a candidate for a later cleanup unit, not this one.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "SUPPORTED"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Elapsed time between samples exceeded 2x the configured sample interval — a rate computed across that gap would be misleading.",
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "SAMPLE_GAP"
              ]
            }
          }
        },
        {
          "description": "The underlying counter decreased between samples (NIC reinit, process restart, etc.) — never reported as a negative rate.",
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "COUNTER_RESET"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "UNAVAILABLE"
              ]
            }
          }
        }
      ]
    },
    "MetricValue_for_uint64": {
      "description": "A single telemetry number, tagged with why it might not be a plain value. Used for both genuine rates (CPU%, network throughput) and point-in-time gauges (memory used, disk free) — gauges simply never produce the `SampleGap`/`CounterReset` variants. Deliberately separate from `SelfMetricValue<T>` (U0's service self-monitoring type); unifying the two is a candidate for a later cleanup unit, not this one.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "SUPPORTED"
              ]
            },
            "value": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          }
        },
        {
          "description": "Elapsed time between samples exceeded 2x the configured sample interval — a rate computed across that gap would be misleading.",
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "SAMPLE_GAP"
              ]
            }
          }
        },
        {
          "description": "The underlying counter decreased between samples (NIC reinit, process restart, etc.) — never reported as a negative rate.",
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "COUNTER_RESET"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "UNAVAILABLE"
              ]
            }
          }
        }
      ]
    },
    "StorageSnapshot": {
      "type": "object",
      "required": [
        "timestamp",
        "volumes"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "volumes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VolumeInfo"
          }
        }
      }
    },
    "VolumeInfo": {
      "type": "object",
      "required": [
        "available_bytes",
        "capacity_bytes",
        "device",
        "filesystem",
        "free_bytes",
        "io_latency_ms",
        "mount_point",
        "read_bytes_per_sec",
        "read_ops_per_sec",
        "write_bytes_per_sec",
        "write_ops_per_sec"
      ],
      "properties": {
        "available_bytes": {
          "$ref": "#/definitions/MetricValue_for_uint64"
        },
        "capacity_bytes": {
          "$ref": "#/definitions/MetricValue_for_uint64"
        },
        "device": {
          "type": "string"
        },
        "filesystem": {
          "type": "string"
        },
        "free_bytes": {
          "$ref": "#/definitions/MetricValue_for_uint64"
        },
        "io_latency_ms": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "mount_point": {
          "type": "string"
        },
        "read_bytes_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "read_ops_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "write_bytes_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        },
        "write_ops_per_sec": {
          "$ref": "#/definitions/MetricValue_for_double"
        }
      }
    }
  }
}
